# ===== 新增、修改、刪除課程 =====
msgid "Add course"
msgstr "新增課程"

msgid "Edit course"
msgstr "修改課程"

msgid "Class times"
msgstr "上課時段"

msgid "+ Add another time"
msgstr "＋ 再加一個時段"

msgid "From"
msgstr "從"

msgid "To"
msgstr "到"

msgid "Remove"
msgstr "刪除"

msgid "Start period"
msgstr "開始節次"

msgid "End period"
msgstr "結束節次"

msgid "Add at least one class time."
msgstr "請至少設定 1 個上課時段。"

msgid "Class times of the same course overlap. Please check them."
msgstr "同一門課的上課時段重疊了，請檢查。"

msgid "⚠ This course overlaps with other courses:"
msgstr "⚠ 這門課和其他課程衝堂："

msgid "I know about the overlap. Save anyway (e.g. auditing or alternate weeks)."
msgstr "我知道衝堂，仍要儲存（例如旁聽、隔週上課）"

msgid "%(time)s overlaps with “%(course)s” (%(other)s)"
msgstr "%(time)s 與「%(course)s」（%(other)s）衝堂"

msgid "Added “%(name)s”."
msgstr "已新增「%(name)s」。"

msgid "Updated “%(name)s”."
msgstr "已更新「%(name)s」。"

msgid "Deleted “%(name)s”."
msgstr "已刪除「%(name)s」。"

msgid "Delete course"
msgstr "刪除課程"

msgid "Delete “<strong>%(name)s</strong>”? All of its class times will be deleted too, and this can’t be undone."
msgstr "確定要刪除「<strong>%(name)s</strong>」嗎？這門課的所有上課時段都會一起刪除，而且無法復原。"

# ===== 分享 =====
msgid "Share timetable"
msgstr "分享課表"

msgid "When sharing is on, anyone with the link can view your timetable without logging in, including teachers, classrooms and notes, but they can’t change anything."
msgstr "開啟分享後，任何拿到連結的人不必登入就能看你的課表，包含老師、教室和備註，但不能修改。"

msgid "Status:"
msgstr "目前狀態："

msgid "Sharing"
msgstr "分享中"

msgid "Not shared"
msgstr "未分享"

msgid "Share link"
msgstr "分享連結"

msgid "Copy link"
msgstr "複製連結"

msgid "Copied!"
msgstr "已複製！"

msgid "Preview the shared page in a new tab"
msgstr "在新分頁預覽分享頁"

msgid "Create a new link"
msgstr "重新產生連結"

msgid "Stop sharing"
msgstr "停止分享"

msgid "A new link makes the old one stop working right away. Useful if the link was passed to someone you didn’t intend."
msgstr "重新產生後舊連結會立刻失效，適合連結被轉傳給不想讓他看的人時使用。"

msgid "Turn on sharing"
msgstr "開啟分享"

msgid "Back to my timetable"
msgstr "回到我的課表"

msgid "Read-only"
msgstr "唯讀"

msgid "This timetable has no courses yet."
msgstr "這份課表目前沒有課程。"

msgid "Want a timetable of your own?"
msgstr "想做一份自己的課表？"

msgid "Sharing is on. Send the link to anyone you like."
msgstr "已開啟分享，把連結傳給想分享的人吧。"

msgid "Sharing is off. The old link no longer works."
msgstr "已停止分享，原本的連結已無法開啟。"

msgid "A new link has been created. The old link no longer works."
msgstr "已產生新連結，舊連結已失效。"

msgid "Share link of %(user)s"
msgstr "%(user)s 的分享連結"

# ===== 錯誤頁 =====
msgid "Page not found"
msgstr "找不到這個頁面"

msgid "The address may be wrong, or this timetable is no longer shared."
msgstr "網址可能打錯了，或是這份課表已經停止分享。"

msgid "Something went wrong"
msgstr "系統發生錯誤"

msgid "Please try again later. If this keeps happening, contact the site administrator."
msgstr "請稍後再試。如果一直出現這個畫面，請聯絡網站管理者。"

