# ===== 首頁 =====
msgid "Your timetable, wherever you go"
msgstr "你的課表，隨時帶著走"

msgid "Add courses, color them by category, total your credits, and check where your next class is right from your phone."
msgstr "新增課程、依類別上色、自動計算學分，手機上也能查「現在該去哪上課」。"

# ===== 帳號 =====
msgid "Email"
msgstr "Email"

msgid "This email is already registered."
msgstr "這個 Email 已經註冊過了。"

msgid "Create account"
msgstr "建立帳號"

msgid "Already have an account?"
msgstr "已經有帳號了？"

msgid "No account yet?"
msgstr "還沒有帳號？"

msgid "Forgot password?"
msgstr "忘記密碼？"

msgid "Welcome, %(name)s! Your account has been created."
msgstr "歡迎，%(name)s！帳號已建立。"

# ===== 忘記密碼 =====
msgid "Forgot password"
msgstr "忘記密碼"

msgid "Enter the email you signed up with and we’ll send you a link to reset your password."
msgstr "輸入註冊時填寫的 Email，我們會寄一封重設密碼的信給你。"

msgid "Send reset email"
msgstr "寄出重設密碼信"

msgid "Check your email"
msgstr "請查收信件"

msgid "If an account exists for this email, we’ve sent a password reset link. Please use it within 24 hours."
msgstr "如果這個 Email 有註冊帳號，重設密碼的信已經寄出，請在 24 小時內點信中的連結。"

msgid "Didn’t get it? Check your spam folder or make sure you entered the right email."
msgstr "沒收到的話，請檢查垃圾郵件匣，或確認輸入的 Email 是否正確。"

msgid "Set a new password"
msgstr "設定新密碼"

msgid "Update password"
msgstr "更新密碼"

msgid "Link expired"
msgstr "連結已失效"

msgid "This password reset link has already been used or has expired."
msgstr "這個重設密碼連結已經用過或已過期。"

msgid "Send a new reset email"
msgstr "重新寄一封重設密碼信"

msgid "Password updated"
msgstr "密碼已更新"

msgid "Please log in with your new password."
msgstr "請用新密碼登入。"

msgid "Go to log in"
msgstr "前往登入"

msgid "[Online Timetable] Reset your password"
msgstr "【線上個人課表】重設密碼"

msgid "Hi %(name)s,"
msgstr "%(name)s 你好："

msgid "We received a request to reset the password for your Online Timetable account. Use the link below within 24 hours to set a new password:"
msgstr "我們收到重設「線上個人課表」帳號密碼的申請。請在 24 小時內點下面的連結設定新密碼："

msgid "If you didn’t request this, just ignore this email. Your password won’t change."
msgstr "如果不是你本人申請，請直接忽略這封信，你的密碼不會改變。"

