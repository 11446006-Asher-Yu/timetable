msgstr "還沒有排給你的課。"

msgid "Accepted %(count)s class."
msgid_plural "Accepted %(count)s classes."
msgstr[0] "已接受 %(count)s 門課。"

msgid "Request a change"
msgstr "申請調整"

msgid "Request a change: %(name)s"
msgstr "申請調整：%(name)s"

msgid "Preferred times (optional)"
msgstr "希望的時段（可不選）"

msgid "Send request"
msgstr "送出申請"

msgid "Your request has been sent to the scheduler."
msgstr "已把申請送給排課人員。"

# 課程目錄
msgid "Course catalog"
msgstr "課程目錄"

msgid "No timetable has been published yet."
msgstr "還沒有公布的課表。"

msgid "Search course or teacher…"
msgstr "搜尋課程或老師…"

