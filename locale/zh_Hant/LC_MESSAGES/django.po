msgstr "我的調整申請"

msgid "Submitted %(date)s"
msgstr "已於 %(date)s 送出"

msgid "The availability form is closed. Contact the scheduler if you need to change it."
msgstr "可授課時段已關閉填寫，需要修改請聯絡排課人員。"

msgid "Tap a cell to switch: ✓ Available → ~ Prefer not → ✗ Unavailable."
msgstr "點一下格子切換：✓ 可以 → ~ 盡量避免 → ✗ 不行。"

msgid "Set all available"
msgstr "全部設為可以"

msgid "Submitted. Thank you!"
msgstr "已送出，謝謝！"

msgid "Accept all pending"
msgstr "全部接受"

msgid "Accept"
msgstr "接受"

msgid "Request change"
msgstr "申請調整"

