msgstr "系統會寄出 7 天內有效的連結，老師建立帳號（或登入）後即可接受邀請。"

msgid "Send invitation"
msgstr "寄出邀請"

msgid "Teacher’s name"
msgstr "老師姓名"

msgid "Invitation sent to %(email)s."
msgstr "已寄出邀請給 %(email)s。"

# 公布
msgid "Publish timetable"
msgstr "公布課表"

msgid "First published on %(date)s."
msgstr "首次公布於 %(date)s。"

msgid "%(counter)s offering is not accepted yet and won’t be published."
msgid_plural "%(counter)s offerings are not accepted yet and won’t be published."
msgstr[0] "還有 %(counter)s 門開課尚未確認，不會公布。"

msgid "Publish %(counter)s accepted offering"
msgid_plural "Publish %(counter)s accepted offerings"
msgstr[0] "公布 %(counter)s 門已確認的開課"

msgid "Unpublish"
msgstr "撤回公布"

msgid "Published %(count)s offering."
msgid_plural "Published %(count)s offerings."
msgstr[0] "已公布 %(count)s 門開課。"

msgid "Unpublished “%(name)s”."
msgstr "已撤回公布「%(name)s」。"

# 老師：接受邀請
msgid "Teacher invitation"
msgstr "老師邀請"

msgid "You’re invited to teach"
msgstr "邀請你加入授課"

msgid "Invitation already used"
msgstr "邀請已使用"

msgid "This invitation has already been accepted."
msgstr "這個邀請已經被接受了。"

msgid "Go to teacher pages"
msgstr "前往授課頁面"

msgid "Invitation expired"
msgstr "邀請已過期"

msgid "Ask the scheduler to send you a new invitation."
msgstr "請排課人員重新寄一封邀請給你。"

msgid "Hi %(name)s, %(inviter)s invited you to join Online Timetable as a teacher."
msgstr "%(name)s 你好，%(inviter)s 邀請你以老師身分加入線上個人課表。"

msgid "You’ll accept as %(username)s."
msgstr "將以 %(username)s 帳號接受邀請。"

msgid "Accept invitation"
msgstr "接受邀請"

msgid "Create an account"
msgstr "建立帳號"

msgid "Already have one?"
msgstr "已經有帳號了？"

msgid "Log in to accept"
msgstr "登入後接受"

msgid "This invitation expires on %(date)s."
msgstr "這個邀請將於 %(date)s 到期。"

msgid "Welcome! You can now use the teacher pages."
msgstr "歡迎！你現在可以使用授課頁面了。"

# 老師：首頁、可授課時段、我的授課
msgid "The scheduler hasn’t created a term yet."
msgstr "排課人員還沒有建立學期。"

msgid "My availability"
msgstr "我的可授課時段"

msgid "My classes"
msgstr "我的授課"

msgid "%(counter)s to confirm"
