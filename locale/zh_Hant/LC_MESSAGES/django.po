msgstr "仍要加入"

msgid "In my timetable"
msgstr "已在我的課表"

msgid "+ Add"
msgstr "＋ 加入"

msgid "No courses match your search."
msgstr "沒有符合條件的課程。"

# 通知信
msgid "Hi %(name)s,\n\n%(inviter)s invited you to join Online Timetable as a teacher. Open the link below to accept (valid for 7 days):\n\n%(link)s"
msgstr "%(name)s 你好：\n\n%(inviter)s 邀請你以老師身分加入線上個人課表。請在 7 天內點下面的連結接受邀請：\n\n%(link)s"

msgid "Please submit your availability for %(term)s"
msgstr "請填寫 %(term)s 的可授課時段"

msgid "The availability form for %(term)s is open. Please mark the periods you can and can’t teach by %(deadline)s:\n\n%(link)s"
msgstr "%(term)s 的可授課時段已開放填寫，請在 %(deadline)s 前標示可以和不能上課的節次：\n\n%(link)s"

msgid "Please confirm your class schedule"
msgstr "請確認你的排課"

msgid "These classes have been scheduled for you. Please accept them or request a change:\n\n%(lines)s\n\n%(link)s"
msgstr "以下課程已排定，請接受或申請調整：\n\n%(lines)s\n\n%(link)s"

msgid "Change requested: %(course)s"
msgstr "調整申請：%(course)s"

msgid "%(teacher)s requested a change to “%(course)s”.\n\nReason: %(reason)s\n\n%(link)s"
msgstr "%(teacher)s 申請調整「%(course)s」。\n\n理由：%(reason)s\n\n%(link)s"

msgid "Your change request for %(course)s was %(result)s"
msgstr "你對「%(course)s」的調整申請：%(result)s"

msgid "Reply from the scheduler: %(reply)s\n\n%(link)s"
msgstr "排課人員的回覆：%(reply)s\n\n%(link)s"

msgid "The %(term)s timetable is published"
msgstr "%(term)s 課表已公布"

msgid "The timetable for %(term)s is now published. Students can add your classes from the catalog.\n\n%(link)s"
msgstr "%(term)s 的課表已公布，學生可以從課程目錄加入你的課。\n\n%(link)s"

